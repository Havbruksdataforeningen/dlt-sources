# BarentsWatch Fish Health API — secrets configuration
# Copy this file to secrets.toml and fill in your credentials:
#   cp .dlt/secrets.toml.example .dlt/secrets.toml
#
# NEVER commit secrets.toml to version control. The .gitignore already excludes it.

[sources.barentswatch_fishhealth]
# OAuth2 client credentials. The source exchanges them for a bearer token at
# https://id.barentswatch.no/connect/token and refreshes it when it expires.
# To obtain: register an API client under "Min side" at https://www.barentswatch.no/minside/
# — see https://developer.barentswatch.no/docs/appreg
client_id = "your-client-id-here"
client_secret = "your-client-secret-here"
