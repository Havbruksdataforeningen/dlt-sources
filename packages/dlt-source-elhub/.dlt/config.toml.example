# Elhub Energy Data API — dlt pipeline configuration
# Copy this file to config.toml and adjust as needed:
#   cp .dlt/config.toml.example .dlt/config.toml
#
# CI never reads this file: the default test run is offline and needs no
# credentials. Both files are yours to create locally.

[sources.elhub]
# Elhub answers 403 to a request without a User-Agent. Name yourself.
user_agent = "my-company-elhub-pipeline"

# Organisation number of the company whose metering points to read, when that company has
# delegated the scope to the client's organisation in Altinn. Leave it out to read the
# client's own organisation. One source per company: see examples/companies.py.
# consumer_org = "999999999"

# Where a metering point the source has not seen before starts: values inserted at or after
# this instant, ISO 8601 with offset. Left out, it is everything Elhub retains, which is
# 3 years and 41 days of history in one request per metering point. Set a recent instant
# for a first run that loads only what is new. REFERENCE.md explains the cursor.
# initial_insert_date_time = "2026-10-01T00:00:00+02:00"

# Query params belong to the resource that sends them, so they are configured per
# resource — the same names the API documents, in snake_case. Everything below is
# optional, and binding one of them means the resource sends exactly that window: the
# stored cursor is neither read nor advanced. Dates are yyyy-MM-dd'T'HH:mm:ssXXX in
# Europe/Oslo. The README's "Configuring a resource" says what each one costs.

# [sources.elhub.metering_points]
# start_date = "2026-10-12T00:00:00+02:00"
# end_date = "2026-10-13T00:00:00+02:00"

# [sources.elhub.metering_values_hour]
# start_date = "2026-10-01T00:00:00+02:00"
# end_date = "2026-10-13T00:00:00+02:00"
# insert_date_time = "2026-10-01T00:00:00+02:00"
