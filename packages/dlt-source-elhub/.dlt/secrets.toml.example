# Copy to .dlt/secrets.toml, which is gitignored. Never commit the copy.
#
# From the client in Digdir's self-service portal (https://sjolvbetjening.samarbeid.digdir.no/):
# the client id, the key id of its registered public key, and the matching private key, which the
# portal shows once. Elhub grants the scope elhub:enduser to your organisation on request.

[sources.elhub.credentials]
client_id = "00000000-0000-0000-0000-000000000000"
kid = "00000000-0000-0000-0000-000000000000"
private_key = """-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"""
# Test environment, which needs a client registered there:
# maskinporten_url = "https://test.maskinporten.no"
