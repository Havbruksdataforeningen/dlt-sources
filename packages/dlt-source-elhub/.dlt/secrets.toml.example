# Aquabyte API v3 — secrets configuration
# Copy this file to secrets.toml and fill in your credentials:
#   cp .dlt/secrets.toml.example .dlt/secrets.toml
#
# NEVER commit secrets.toml to version control. The .gitignore already excludes it.

[sources.aquabyte]
# Aquabyte API key — passed as the 'apikey' HTTP header on every request
# To obtain: contact Aquabyte to be issued an API key
# Rate limit: 1000 requests/hour
api_key = "your-api-key-here"
