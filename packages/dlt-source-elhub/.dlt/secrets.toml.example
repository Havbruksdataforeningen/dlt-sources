# Elhub Energy Data API — secrets configuration
# Copy this file to secrets.toml and fill in your Maskinporten client:
#   cp .dlt/secrets.toml.example .dlt/secrets.toml
#
# NEVER commit secrets.toml to version control. The .gitignore already excludes it.
#
# The three values come from the client registered in Digdir's self-service portal
# (https://sjolvbetjening.samarbeid.digdir.no/): the client id, the key id of the public
# key registered on it, and the matching private key, which the portal shows once.
# Elhub has to grant the scope elhub:enduser to your organisation first.

[sources.elhub.credentials]
client_id = "00000000-0000-0000-0000-000000000000"
kid = "00000000-0000-0000-0000-000000000000"
private_key = """-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"""
# Test environment, which needs a client registered there:
# maskinporten_url = "https://test.maskinporten.no"
