# Aquabyte API v3 — dlt pipeline configuration
# Copy this file to config.toml and adjust as needed:
#   cp .dlt/config.toml.example .dlt/config.toml
#
# CI/CD: The GitHub Actions workflow (.github/workflows/ci.yml)
# generates config.toml and secrets.toml automatically. Add your API key as a
# GitHub repository secret named AQUABYTE_API_KEY.

[sources.aquabyte]
# Base URL for the Aquabyte API v3
# Docs: https://api.aquabyte.ai/v3/
base_url = "https://api.aquabyte.ai/v3/"

# Aggregation period for environmental data
# Options: "15min", "h" (hourly), "D" (daily)
# Higher granularity = more data points and API calls per pen
environmental_period = "D"

# Aggregation period for behavior data (only used by behaviour_swim_speed)
# Options: "h" (hourly), "D" (daily)
behavior_period = "D"

# Initial value for date-based incremental endpoints (biomass, harvest_report, lice_count, welfare_scores)
# Format: YYYY-MM-DD
initial_date = "2020-01-01"

# Initial value for time-based incremental endpoints (environmental, behaviour_swim_speed, behaviour_breathing_index)
# Format: ISO 8601 timestamp
initial_time = "2020-01-01T00:00:00Z"
